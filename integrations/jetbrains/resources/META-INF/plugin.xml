<idea-plugin>
  <id>com.lunavect.sessions</id>
  <name>Lunavect Sessions</name>
  <version>0.1.0</version>
  <vendor url="https://github.com/lovach/Lunavect">Lunavect</vendor>
  <description>Focus an existing Claude or Codex terminal session from Lunavect.</description>
  <idea-version since-build="262" until-build="262.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.lunavect.sessions.BridgeService"/>
    <postStartupActivity implementation="com.lunavect.sessions.BridgeStartup"/>
  </extensions>
</idea-plugin>
